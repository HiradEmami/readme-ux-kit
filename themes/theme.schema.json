{
  "$id": "https://hirademami.github.io/readme-ux-kit/schemas/theme.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "colors": {
      "items": {
        "required": [
          "token",
          "hex",
          "use"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "motionLevel": {
      "enum": [
        "low",
        "moderate",
        "high"
      ]
    },
    "name": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "colors",
    "recommendedTemplates"
  ],
  "title": "README UX Kit Theme Tokens",
  "type": "object"
}
