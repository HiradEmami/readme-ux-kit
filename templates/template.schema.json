{
  "$id": "https://hirademami.github.io/readme-ux-kit/schemas/template.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "templateCount": {
      "minimum": 1,
      "type": "integer"
    },
    "templates": {
      "items": {
        "required": [
          "path",
          "contract",
          "title",
          "maturity"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "templateCount",
    "templates"
  ],
  "title": "README UX Kit Template Index",
  "type": "object"
}
